# =============================================================================
# PocketClaw Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# Or run: npm run setup (interactive wizard)

# -----------------------------------------------------------------------------
# Required: Telegram Bot
# -----------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram:
# 1. Open https://t.me/botfather
# 2. Send /newbot
# 3. Follow prompts to create your bot
# 4. Copy the token here
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID (only you can control the bot)
# Run the setup wizard to auto-capture this, or find it manually:
# 1. Message @userinfobot on Telegram
# 2. Copy your ID
TELEGRAM_ALLOWED_USER_ID=

# -----------------------------------------------------------------------------
# Required: Claude Authentication (choose ONE)
# -----------------------------------------------------------------------------
# Option 1: Use your Claude Code OAuth token (recommended for Max plan users)
# Found in ~/.claude/config.json
CLAUDE_CODE_OAUTH_TOKEN=

# Option 2: Use Anthropic API key (if you don't have Max plan)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Voice Transcription
# -----------------------------------------------------------------------------
# Deepgram API key for voice note transcription
# Sign up (free tier available): https://deepgram.com
# Leave empty to disable voice notes
DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Project Configuration
# -----------------------------------------------------------------------------
# Default directory for Claude Code to work in
# If not set, defaults to your home directory
DEFAULT_PROJECT_DIR=

# -----------------------------------------------------------------------------
# Optional: Claude Agent SDK Tuning
# -----------------------------------------------------------------------------
# Override default model (e.g., claude-opus-4, claude-sonnet-4)
# CLAUDE_MODEL=

# Fallback model when primary is unavailable
# CLAUDE_FALLBACK_MODEL=

# Maximum turns per conversation (default: unlimited)
# CLAUDE_MAX_TURNS=

# Maximum spend per session in USD (default: unlimited)
# CLAUDE_MAX_BUDGET_USD=
