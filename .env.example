# Copy this file to .env and fill in real values. Never commit .env.

# From @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (from @userinfobot). Only this user can talk to the bot.
TELEGRAM_ALLOWED_USER_ID=

# From https://console.deepgram.com/
DEEPGRAM_API_KEY=

# From https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Default working directory for Claude Code. You can override at runtime with /cd <path>.
DEFAULT_PROJECT_DIR=/Users/jasonki

# --- Optional Claude Agent SDK tuning (leave blank to use CLI defaults) ---

# Pin the model and a fallback, e.g. claude-opus-4-7 / claude-sonnet-4-6.
CLAUDE_MODEL=
CLAUDE_FALLBACK_MODEL=

# Safety guardrails for a phone-driven bot running with bypassPermissions.
# Stop a runaway task after N turns or $X of spend. Blank = no limit.
CLAUDE_MAX_TURNS=
CLAUDE_MAX_BUDGET_USD=
